{
  "name": "af-backup",
  "version": "1.2.0",
  "description": "A simple console tool for personal backups, designed with reliability as the top priority",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "af-backup": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "npm run build && node --test --test-timeout=120000 \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
